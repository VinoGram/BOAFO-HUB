# ─────────────────────────────────────────────────────────────────────────────
# BOAFO Marketplace — Environment Variables Template
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+12015551234
UPLOAD_DIR=uploads
REDIS_URL=redis://localhost:6379/0

# Email delivery (Gmail app password is easiest)
# Enable 2FA in your Google account and create an App Password here:
# https://myaccount.google.com/security
GMAIL_ADDRESS=your@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Optional generic SMTP fallback
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your_smtp_username
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=hello@yourdomain.com

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
